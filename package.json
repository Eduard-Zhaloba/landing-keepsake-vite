{
  "name": "vite-pug-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.js",
    "format": "prettier --write .",
    "lint": "npm run lint:styles && npm run lint:format",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:format": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{pug,js,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.6.0",
    "@vituum/vite-plugin-pug": "^1.1.0",
    "autoprefixer": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "sass": "^1",
    "sharp": "^0.35.5",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "vite": "^5.4.11",
    "vituum": "^1.2.0"
  }
}
