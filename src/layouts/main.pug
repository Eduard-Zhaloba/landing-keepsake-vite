doctype html
html(lang="en")
    head
        block meta
            meta(charset="utf-8")
            meta(name="viewport" content="width=device-width, initial-scale=1")
        block title
            title Keepsake - Digital & Branding Agency
        block fonts
            link(rel="preconnect" href="https://fonts.googleapis.com")
            link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
            link(href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Open+Sans:wght@300;400;600&family=Oswald:wght@300;400;600&display=swap" rel="stylesheet")
        block main-scripts
        block styles
            link(rel="stylesheet" href="/src/styles/main.scss")
    body
        block data
        block header
            header.page-header header
        block content
            main.page-main content
        block footer
            footer.page-footer footer
        block add-scripts